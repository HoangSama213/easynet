{
  "name": "easynet/app",
  "description": "Khung test tối thiểu cho dự án EasyNet PHP thuần",
  "type": "project",
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml",
    "check:php": "@php tools/php-lint.php",
    "check": [
      "@check:php",
      "@test"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
